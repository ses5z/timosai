# TimosAI ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp doldurun. .env repoya girmez.
PORT=3000
# live: OKX Agent Trade Kit (stdio MCP) | mock: örnek veri
ATK_MODE=live
OKX_SITE=tr
# false = KURU ÇALIŞMA (kâğıt işlem). Gerçek emir için bilinçli olarak true yapın.
LIVE=false
AUTONOMOUS=true
SCAN_INTERVAL_SEC=30
PAPER_BALANCE_USDT=30

# OKX API (yalnızca hesap/emir için; piyasa verisi anahtarsız çalışır)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Mentor: gemini | claude | rule
MENTOR_PROVIDER=gemini
# Boşsa gemini-3.8-flash (ücretsiz katman). Claude için CLAUDE_MODEL boşsa claude-haiku-5-5.
MENTOR_MODEL=
MENTOR_HOURLY_LIMIT=60
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
